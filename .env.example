# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Sem estas variáveis o app roda no modo protótipo (localStorage).
# A chave "anon" pode ficar no app; NUNCA coloque aqui a chave "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
